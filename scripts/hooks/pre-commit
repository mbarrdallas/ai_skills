#!/usr/bin/env bash
#
# pre-commit - validate staged skills, agents and workflows before committing.
#
# Installed by scripts/install_hooks.sh, which sets:
#   git config core.hooksPath scripts/hooks
# so this hook is VERSION CONTROLLED rather than living in .git/hooks (which
# isn't committed and silently doesn't exist for anyone who clones the repo).
#
# Scope: validates only what's actually STAGED, so a docs-only commit doesn't
# pay for a full 6s repo sweep. Falls back to a full run when a shared file
# (e.g. a validator or _lib.sh) changes, since that can affect everything.
#
# Escape hatch: `git commit --no-verify`, or PRECOMMIT_SKIP=1 git commit ...
# Use it deliberately, not habitually - see "Fix Errors in Skills and Agents
# When You Find Them" in ~/WORKSPACE/AGENTS.md.
#
set -uo pipefail

if [ "${PRECOMMIT_SKIP:-0}" = "1" ]; then
  printf 'pre-commit: skipped (PRECOMMIT_SKIP=1)\n' >&2
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'
C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
say()  { printf '%spre-commit%s %s\n' "$C_BOLD" "$C_RESET" "$1"; }
fail() { printf '%spre-commit FAIL%s %s\n' "$C_RED" "$C_RESET" "$1" >&2; }
warn() { printf '%spre-commit WARN%s %s\n' "$C_YELLOW" "$C_RESET" "$1" >&2; }
ok()   { printf '%spre-commit OK%s   %s\n' "$C_GREEN" "$C_RESET" "$1"; }

# Staged, added/copied/modified/renamed (not deleted - nothing left to check).
STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$STAGED" ] || exit 0

# THIRDPARTY/ is vendored - not ours to validate.
STAGED="$(printf '%s\n' "$STAGED" | grep -v '^THIRDPARTY/' || true)"
[ -n "$STAGED" ] || exit 0

RC=0
RAN_ANYTHING=0

# --- 1. Shell syntax check on staged scripts ------------------------------
# Cheap, and catches the class of error that otherwise only shows up when a
# script is next run - possibly inside a consuming repo.
SH_FILES="$(printf '%s\n' "$STAGED" | grep -E '\.sh$' || true)"
if [ -n "$SH_FILES" ]; then
  RAN_ANYTHING=1
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    if ! bash -n "$f" 2>/tmp/precommit_sh.$$; then
      fail "shell syntax error in $f"
      sed 's/^/        /' /tmp/precommit_sh.$$ >&2
      RC=1
    fi
    # A committed script that isn't executable is a silent trap for callers.
    case "$(git ls-files --stage "$f" | awk '{print $1}')" in
      100755) ;;
      100644) warn "$f is committed non-executable (chmod +x and re-stage?)" ;;
    esac
  done <<<"$SH_FILES"
  [ "$RC" -eq 0 ] && ok "shell syntax"
fi
rm -f /tmp/precommit_sh.$$

# --- 2. Did a SHARED file change? Then validate everything ----------------
# A change to a validator, the shared lib, or the conventions skill can
# invalidate any item in the repo, so narrow validation would be misleading.
if printf '%s\n' "$STAGED" | grep -qE '^scripts/(_lib\.sh|validate_.*\.sh)$|^skills/workflow-conventions/'; then
  say 'shared validator/conventions file changed - running full validation'
  ./scripts/validate_all.sh >/tmp/precommit_all.$$ 2>&1
  if grep -qE '^FAIL|Fail: [1-9]' /tmp/precommit_all.$$; then
    fail 'validate_all.sh reported failures:'
    grep -E '^(FAIL|Pass:)' /tmp/precommit_all.$$ | sed 's/^/        /' >&2
    RC=1
  else
    ok "$(grep -c '^PASS' /tmp/precommit_all.$$ 2>/dev/null || echo '?') checks passed (full run)"
  fi
  rm -f /tmp/precommit_all.$$
  RAN_ANYTHING=1
else
  # --- 3. Otherwise validate only the affected items --------------------
  # Skills: map any staged path under skills/<name>/ to that skill dir.
  SKILLS="$(printf '%s\n' "$STAGED" | sed -n 's|^\(skills/[^/]*\)/.*|\1|p' | sort -u)"
  # Workflow-private skills too.
  SKILLS="$SKILLS
$(printf '%s\n' "$STAGED" | sed -n 's|^\(WORKFLOWS/[^/]*/PRIVATE/SKILLS/[^/]*\)/.*|\1|p' | sort -u)"
  for d in $(printf '%s\n' "$SKILLS" | sed '/^$/d' | sort -u); do
    [ -d "$d" ] || continue
    RAN_ANYTHING=1
    if ! ./scripts/validate_skill.sh "$d" 2>&1 | grep -qE '^FAIL'; then
      ok "skill $(basename "$d")"
    else
      fail "skill $d"
      ./scripts/validate_skill.sh "$d" 2>&1 | grep -E '^(FAIL|WARN)' | sed 's/^/        /' >&2
      RC=1
    fi
  done

  # Agents: public AGENTS/*.md and workflow-private PRIVATE/AGENTS/*.md.
  AGENTS_F="$(printf '%s\n' "$STAGED" | grep -E '^AGENTS/.*\.md$|^WORKFLOWS/[^/]*/PRIVATE/AGENTS/.*\.md$' || true)"
  if [ -n "$AGENTS_F" ]; then
    while IFS= read -r f; do
      [ -f "$f" ] || continue
      RAN_ANYTHING=1
      out="$(./scripts/validate_agent.sh "$f" 2>&1)"
      if printf '%s' "$out" | grep -qE '^FAIL'; then
        fail "agent $f"
        printf '%s\n' "$out" | grep -E '^(FAIL|WARN)' | sed 's/^/        /' >&2
        RC=1
      else
        ok "agent $(basename "$f")"
        printf '%s\n' "$out" | grep -E '^WARN' | sed 's/^/        /' >&2 || true
      fi
    done <<<"$AGENTS_F"
  fi

  # Workflows: map any staged WORKFLOWS/<name>/... to that workflow dir.
  WFS="$(printf '%s\n' "$STAGED" | sed -n 's|^\(WORKFLOWS/[^/]*\)/.*|\1|p' | sort -u)"
  for d in $(printf '%s\n' "$WFS" | sed '/^$/d'); do
    [ -d "$d" ] || continue
    RAN_ANYTHING=1
    out="$(./scripts/validate_workflow.sh "$d" 2>&1)"
    if printf '%s' "$out" | grep -qE '^FAIL'; then
      fail "workflow $(basename "$d")"
      printf '%s\n' "$out" | grep -E '^FAIL' | sed 's/^/        /' >&2
      RC=1
    else
      ok "workflow $(basename "$d")"
    fi
  done
fi

# --- 4. Harness sync: only if a skill/agent was ADDED or RENAMED ----------
# The documented rule is that a new public skill/agent must be linked into the
# harness at creation time (see ~/WORKSPACE/AGENTS.md), and an unlinked skill
# silently never triggers. Enforced only when the harness actually exists on
# this machine, so a clone/CI without ~/.pi isn't blocked by local env state.
NEW_ITEMS="$(git diff --cached --name-only --diff-filter=AR \
  | grep -E '^skills/[^/]+/SKILL\.md$|^AGENTS/[^/]+\.md$' || true)"
HARNESS_DIR="${PI_AGENT_DIR:-$HOME/.pi/agent}"
if [ -n "$NEW_ITEMS" ] && [ -d "$HARNESS_DIR" ]; then
  RAN_ANYTHING=1
  if ./scripts/install_all.sh --check --quiet >/tmp/precommit_link.$$ 2>&1; then
    ok 'harness links in sync'
  else
    fail 'a new skill/agent is not linked into the harness - it will never trigger'
    grep -E 'WARN|OUT OF' /tmp/precommit_link.$$ | sed 's/^/        /' >&2
    printf '        fix: ./scripts/install_all.sh\n' >&2
    RC=1
  fi
  rm -f /tmp/precommit_link.$$
fi

# --- 5. Warn if what we validated isn't what's being committed ------------
# We validate working-tree files, so unstaged edits to a staged file mean the
# validated content differs from the committed content.
DIRTY="$(git diff --name-only -- $(printf '%s\n' "$STAGED" | tr '\n' ' ') 2>/dev/null || true)"
if [ -n "$DIRTY" ]; then
  warn 'these staged files have UNSTAGED changes - validation ran against the working tree, not the staged content:'
  printf '%s\n' "$DIRTY" | sed 's/^/        /' >&2
fi

if [ "$RC" -ne 0 ]; then
  printf '\n%sCommit aborted.%s Fix the above, or bypass deliberately with:\n' "$C_RED" "$C_RESET" >&2
  printf '  git commit --no-verify\n' >&2
  exit 1
fi

[ "$RAN_ANYTHING" -eq 1 ] && say 'all checks passed'
exit 0
